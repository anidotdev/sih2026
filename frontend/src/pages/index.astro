---
import "../styles/global.css";

const apiUrl = import.meta.env.PUBLIC_API_URL || "http://127.0.0.1:8000";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />

        <meta name="viewport" content="width=device-width" />

        <meta name="theme-color" content="#ffffff" />

        <meta
            name="description"
            content="Fireline — industrial thermal intelligence powered by satellite fire detection, OSM context and machine learning."
        />

        <title>Fireline</title>

        <link
            href="https://unpkg.com/maplibre-gl@5.6.1/dist/maplibre-gl.css"
            rel="stylesheet"
        />
    </head>

    <body>
        <!-- =====================================================
             Topbar
             ===================================================== -->

        <header class="topbar">
            <div class="brand">
                <div class="brand-mark" aria-hidden="true">◈</div>

                <span> FIRELINE </span>

                <span class="brand-subtitle">
                    Industrial thermal intelligence
                </span>
            </div>

            <div class="topbar-actions">
                <div class="live-status" aria-label="System status">
                    <span class="status-dot" aria-hidden="true"></span>

                    <span id="system-status"> Live </span>
                </div>

                <button
                    id="theme-toggle"
                    class="theme-toggle"
                    type="button"
                    aria-label="Toggle interface theme"
                    title="Toggle interface theme"
                >
                    <span id="theme-icon" aria-hidden="true"> ☼ </span>

                    <span> Theme </span>
                </button>

                <button
                    id="refresh-button"
                    class="refresh-button"
                    type="button"
                >
                    Refresh
                </button>
            </div>
        </header>

        <main class="container">
            <!-- =================================================
                 Hero
                 ================================================= -->

            <section class="hero">
                <div class="eyebrow">INDUSTRIAL FIRE MONITORING</div>

                <h1>
                    Thermal anomalies,<br />
                    with context.
                </h1>

                <p>
                    Detect persistent satellite hotspots and distinguish
                    potential industrial fires from agricultural burning,
                    wildfires and other thermal anomalies using FIRMS, OSM and
                    ML.
                </p>
            </section>

            <!-- =================================================
                 Metrics
                 ================================================= -->

            <section class="metrics" aria-label="Fire monitoring metrics">
                <div class="metric">
                    <span> ACTIVE CLUSTERS </span>

                    <strong id="active-clusters"> 0 </strong>
                </div>

                <div class="metric">
                    <span> HIGH RISK </span>

                    <strong id="high-risk"> 0 </strong>
                </div>

                <div class="metric">
                    <span> MAX FRP </span>

                    <strong id="max-frp"> 0.00 </strong>
                </div>

                <div class="metric">
                    <span> PERSISTENT </span>

                    <strong id="persistent"> 0 </strong>
                </div>
            </section>

            <!-- =================================================
                 Main dashboard
                 ================================================= -->

            <section class="dashboard-grid">
                <!-- =================================================
                     Map
                     ================================================= -->

                <div class="panel map-panel">
                    <div class="panel-header map-header">
                        <div class="map-title">
                            <span> Activity map </span>

                            <span class="muted" id="map-context">
                                Loading...
                            </span>
                        </div>

                        <div class="map-header-actions">
                            <select
                                id="state-select"
                                class="state-select"
                                aria-label="Select state"
                                disabled
                            >
                                <option value=""> Loading states... </option>
                            </select>

                            <span class="muted" id="industrial-count">
                                0 industrial features
                            </span>
                        </div>
                    </div>

                    <div
                        id="map"
                        aria-label="Interactive industrial fire activity map"
                    >
                    </div>
                </div>

                <!-- =================================================
                     Alerts
                     ================================================= -->

                <aside class="panel alerts-panel" aria-label="Fire alerts">
                    <div class="panel-header">
                        <span> Alerts </span>

                        <span id="alert-count" class="muted"> 0 </span>
                    </div>

                    <div id="alerts">
                        <div class="empty">Loading alerts...</div>
                    </div>
                </aside>
            </section>

            <!-- =================================================
                 Cluster detail
                 ================================================= -->

            <section
                id="cluster-detail"
                class="panel cluster-detail hidden"
                aria-label="Cluster intelligence"
            >
                <div class="detail-header">
                    <div>
                        <span class="detail-eyebrow">
                            CLUSTER INTELLIGENCE
                        </span>

                        <h2 id="detail-title">Cluster</h2>
                    </div>

                    <button
                        id="close-detail"
                        class="detail-close"
                        type="button"
                        aria-label="Close cluster details"
                    >
                        ×
                    </button>
                </div>

                <div class="detail-grid">
                    <div class="detail-item">
                        <span> Classification </span>

                        <strong id="detail-label"> — </strong>
                    </div>

                    <div class="detail-item">
                        <span> Risk score </span>

                        <strong id="detail-risk"> — </strong>
                    </div>

                    <div class="detail-item">
                        <span> Maximum FRP </span>

                        <strong id="detail-frp"> — </strong>
                    </div>

                    <div class="detail-item">
                        <span> Persistence </span>

                        <strong id="detail-persistence"> — </strong>
                    </div>

                    <div class="detail-item">
                        <span> Industrial distance </span>

                        <strong id="detail-distance"> — </strong>
                    </div>

                    <div class="detail-item">
                        <span> Confidence </span>

                        <strong id="detail-confidence"> — </strong>
                    </div>
                </div>

                <div class="detail-reason">
                    <span> Assessment </span>

                    <p id="detail-reason-text">—</p>
                </div>
            </section>

            <!-- =================================================
                 Cluster table
                 ================================================= -->

            <section
                class="panel clusters-panel"
                aria-label="Recent fire clusters"
            >
                <div class="panel-header table-header">
                    <div>
                        <span> Recent clusters </span>

                        <small> Ranked by thermal and contextual risk </small>
                    </div>
                </div>

                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th> Cluster </th>

                                <th> Classification </th>

                                <th> FRP </th>

                                <th> Persistence </th>

                                <th> Industrial distance </th>

                                <th> Risk </th>
                            </tr>
                        </thead>

                        <tbody id="clusters-table">
                            <tr>
                                <td colspan="6" class="empty">
                                    Loading clusters...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </main>

        <!-- =====================================================
             MapLibre
             ===================================================== -->

        <script src="https://unpkg.com/maplibre-gl@5.6.1/dist/maplibre-gl.js"
        ></script>

        <!-- =====================================================
             Fireline runtime configuration
             ===================================================== -->

        <script define:vars={{ apiUrl }}>
            window.__FIRELINE_CONFIG__ = {
                API_URL: apiUrl,
            };

            console.log("[Fireline] API:", window.__FIRELINE_CONFIG__.API_URL);
        </script>

        <!-- =====================================================
             Fireline application
             ===================================================== -->

        <script type="module" src="/scripts/dashboard.js"></script>
    </body>
</html>
